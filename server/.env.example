# Copy this file to ".env" and fill in your values.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# MongoDB. Leave empty to use a temporary in-memory database (data resets on restart).
# Local MongoDB:  mongodb://127.0.0.1:27017/fintrack
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fintrack
MONGO_URI=

# Use a long random string in real deployments
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
